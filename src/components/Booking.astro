---
import { siteInfo } from '../data/site';
import { createWhatsAppLink } from '../utils/whatsapp';

const bookingLink = createWhatsAppLink(
  'Hola, me gustaría reservar una cita en Estética Neira. ¿Qué disponibilidad tenéis?',
);
---

<section class="booking section-pad" id="reserva" aria-labelledby="booking-title">
  <div class="booking__grain" aria-hidden="true"></div>
  <div class="booking__inner page-container">
    <div class="booking__copy">
      <p class="eyebrow eyebrow--light"><span class="eyebrow__line" aria-hidden="true"></span>Tu pausa te espera</p>
      <h2 class="booking__title" id="booking-title">Hablemos de<br /><em>tu momento.</em></h2>
      <p class="booking__lead">
        Cuéntanos qué te apetece y te ayudaremos a encontrar el tratamiento que mejor encaje contigo.
      </p>
      <a class="button button--gold button--large" href={bookingLink} target="_blank" rel="noreferrer">
        <svg class="button__whatsapp" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.1 11.8a8.1 8.1 0 0 1-12 7.1l-4.2 1.1 1.1-4.1a8.1 8.1 0 1 1 15.1-4.1Z" />
          <path d="M8.5 8.2c.2-.5.4-.5.7-.5h.5c.2 0 .4.1.5.4l.8 1.8c.1.2.1.4 0 .6l-.5.7c-.1.2-.2.3 0 .5.2.4.8 1.3 1.6 1.9 1 .8 1.8 1.1 2.1 1.2.3.1.4.1.6-.1l.8-.9c.2-.2.4-.2.6-.1l1.7.8c.3.1.4.3.4.5 0 .2-.2 1.1-.7 1.5-.5.5-1.1.7-1.7.7-.4 0-1-.1-1.8-.4-1-.4-2.2-1-3.4-2.1-1-.9-1.9-2.1-2.3-2.8-.4-.7-.7-1.5-.7-2.2 0-.7.3-1.2.6-1.5Z" />
        </svg>
        <span>Escríbenos por WhatsApp</span>
        <svg class="button__arrow" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M4 10h11M10 4l6 6-6 6" />
        </svg>
      </a>
    </div>

    <aside class="booking-card" aria-label="Información de contacto de muestra">
      <div class="booking-card__topline">
        <span class="booking-card__seal" aria-hidden="true">N</span>
        <span class="booking-card__label">Estamos en</span>
      </div>
      <h3>{siteInfo.city}</h3>
      <div class="booking-card__rule" aria-hidden="true"></div>
      <div class="booking-card__detail">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" />
          <circle cx="12" cy="10" r="2.2" />
        </svg>
        <div><small>Visítanos</small><strong>Centro de Valladolid<br />Dirección por confirmar</strong></div>
      </div>
      <div class="booking-card__detail">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 7v5l3.4 2" />
        </svg>
        <div><small>Horario de muestra</small><strong>{siteInfo.openingHours}</strong></div>
      </div>
      <p class="booking-card__demo">Horario y dirección provisionales para esta maqueta.</p>
    </aside>
  </div>
</section>
