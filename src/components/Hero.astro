---
import { createWhatsAppLink } from '../utils/whatsapp';

const bookingLink = createWhatsAppLink(
  'Hola, me gustaría encontrar un tratamiento y reservar una cita en Estética Neira.',
);
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero__inner page-container">
    <div class="hero__visual">
      <div class="hero__image-frame">
        <img
          class="hero__image"
          src="https://images.unsplash.com/photo-1600334129128-685c5582fd35?auto=format&fit=crop&w=1400&q=85"
          alt="Masaje con piedras calientes en una cabina de bienestar"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero__image-wash" aria-hidden="true"></div>
      </div>
      <div class="hero__stamp" aria-hidden="true">
        <span>RESPIRA</span>
        <span class="hero__stamp-star">✳</span>
        <span>DESCANSA</span>
      </div>
      <div class="hero__note">
        <span class="hero__note-kicker">Tu espacio de calma</span>
        <span class="hero__note-copy">Un momento solo para ti.</span>
      </div>
      <span class="hero__image-index" aria-hidden="true">01 / 04</span>
    </div>

    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">
        <span class="eyebrow__line" aria-hidden="true"></span>
        Estética y bienestar · Valladolid
      </p>
      <h1 class="hero__title" id="hero-title">
        Un lugar para<br />
        <em>volver a ti.</em>
      </h1>
      <p class="hero__lead">
        Masajes, cuidado corporal y rituales faciales para hacer una pausa y sentirte bien en tu propia piel.
      </p>

      <div class="hero__actions">
        <a class="button button--dark button--large" href={bookingLink} target="_blank" rel="noreferrer">
          <span>Reserva tu momento</span>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 10h11M10 4l6 6-6 6" />
          </svg>
        </a>
        <a class="text-link" href="#tratamientos">
          <span>Explorar tratamientos</span>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M10 3v13m-5-5 5 5 5-5" />
          </svg>
        </a>
      </div>

      <div class="hero__promise" aria-label="Atención cercana y cuidado personalizado">
        <span class="hero__promise-mark" aria-hidden="true">✳</span>
        <span>Un cuidado cercano, a tu ritmo.</span>
      </div>
    </div>
  </div>
  <div class="hero__ambient hero__ambient--one" aria-hidden="true"></div>
  <div class="hero__ambient hero__ambient--two" aria-hidden="true"></div>
</section>
